---
import { Image } from "astro:assets";
import ImageCarousel from "./ImageCarousel.astro";

interface Props {
  title: string;
  description?: string;
  role?: string;
  organization?: string;
  duration?: string;
  image?: string;
  images?: string[];
  className?: string;
}

const {
  title,
  description,
  role,
  organization,
  duration,
  image,
  images = [],
  className = "",
} = Astro.props;

// Determine which visual approach to use
const hasMultipleImages = images.length > 1;
const hasSingleImage = image && !hasMultipleImages;
const visualContent = hasMultipleImages ? images : hasSingleImage ? [image] : [];
---

<section class={`hero-section ${className}`}>
  <div class="hero-container">
    {/* Text Content */}
    <div class="hero-content">
      <h1 class="hero-title">{title}</h1>

      {description && <p class="hero-description">{description}</p>}

      {/* Project Metadata */}
      {
        (role || organization || duration) && (
          <div class="hero-metadata">
            {role && (
              <div class="metadata-item">
                <span class="metadata-label">Role</span>
                <span class="metadata-value">{role}</span>
              </div>
            )}

            {organization && (
              <div class="metadata-item">
                <span class="metadata-label">Organization</span>
                <span class="metadata-value">{organization}</span>
              </div>
            )}

            {duration && (
              <div class="metadata-item">
                <span class="metadata-label">Duration</span>
                <span class="metadata-value">{duration}</span>
              </div>
            )}
          </div>
        )
      }
    </div>

    {/* Visual Content */}
    {
      visualContent.length > 0 && (
        <div class="hero-visual">
          {hasMultipleImages ? (
            <ImageCarousel images={images} alt={title} />
          ) : hasSingleImage ? (
            <div class="hero-image-single">
              <Image
                src={image!}
                alt={title}
                width={800}
                height={600}
                loading="eager"
                class="single-image"
              />
            </div>
          ) : null}
        </div>
      )
    }
  </div>
</section>

<style>
  .hero-section {
    width: 100%;
    padding: 4rem 0;
    background: linear-gradient(
      to bottom,
      var(--color-background-subtle) 0%,
      var(--color-background) 100%
    );
  }

  .hero-container {
    max-width: var(--max-width-content);
    margin: 0 auto;
    padding: 0 var(--spacing-page-inline);
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  /* Two-column layout for larger screens when visual content exists */
  @media (min-width: 768px) {
    .hero-container:has(.hero-visual) {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  /* Text Content */
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero-title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 3rem;
    }
  }

  .hero-description {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 65ch;
  }

  /* Metadata */
  .hero-metadata {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  @media (min-width: 640px) {
    .hero-metadata {
      flex-direction: row;
      gap: 2rem;
    }
  }

  .metadata-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .metadata-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .metadata-value {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text-primary);
  }

  /* Visual Content */
  .hero-visual {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-image-single {
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    box-shadow:
      0 4px 6px -1px rgb(0 0 0 / 0.1),
      0 2px 4px -2px rgb(0 0 0 / 0.1);
  }

  .single-image {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Full-width variant */
  .hero-section.full-width {
    padding: 6rem 0;
  }

  .hero-section.full-width .hero-container {
    max-width: var(--max-width-wide);
  }

  /* Centered variant (no visual content) */
  .hero-section:not(:has(.hero-visual)) .hero-container {
    max-width: 800px;
    text-align: center;
  }

  .hero-section:not(:has(.hero-visual)) .hero-content {
    align-items: center;
  }

  .hero-section:not(:has(.hero-visual)) .hero-description {
    max-width: 100%;
  }
</style>
