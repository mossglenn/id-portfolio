---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`project-outcomes ${className}`}>
  <slot />
</div>

<style>
  .project-outcomes {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-12, 3rem);
  }

  /* Outcome sections */
  .project-outcomes :global(> section),
  .project-outcomes :global(> div) {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-6, 1.5rem);
  }

  /* Headings */
  .project-outcomes :global(h3) {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text-primary, #111827);
    margin-bottom: var(--spacing-2, 0.5rem);
  }

  .project-outcomes :global(h4) {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-primary, #111827);
    margin-top: var(--spacing-4, 1rem);
    margin-bottom: var(--spacing-2, 0.5rem);
  }

  /* Paragraphs */
  .project-outcomes :global(p) {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary, #374151);
  }

  /* Lists */
  .project-outcomes :global(ul) {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3, 0.75rem);
  }

  .project-outcomes :global(li) {
    position: relative;
    padding-left: var(--spacing-6, 1.5rem);
    line-height: 1.6;
  }

  .project-outcomes :global(li)::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--color-primary, #2563eb);
    font-weight: 700;
  }

  /* Strong text (metrics) */
  .project-outcomes :global(strong) {
    font-weight: 600;
    color: var(--color-text-primary, #111827);
    font-size: 1.125rem;
  }

  /* Metric cards (if wrapped in divs with class) */
  .project-outcomes :global(.metric-card) {
    padding: var(--spacing-6, 1.5rem);
    background: var(--color-background-subtle, #f9fafb);
    border-radius: var(--radius-lg, 12px);
    border: 1px solid var(--color-border, #e5e7eb);
  }

  .project-outcomes :global(.metric-value) {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-primary, #2563eb);
    line-height: 1;
    margin-bottom: var(--spacing-2, 0.5rem);
  }

  .project-outcomes :global(.metric-label) {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-tertiary, #6b7280);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
