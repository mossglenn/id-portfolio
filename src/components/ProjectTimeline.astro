---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`project-timeline ${className}`}>
  <div class="timeline-track"></div>
  <div class="timeline-content">
    <slot />
  </div>
</div>

<style>
  .project-timeline {
    position: relative;
    padding: var(--spacing-8, 2rem) 0;
  }

  .timeline-track {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(
      to bottom,
      var(--color-primary, #2563eb) 0%,
      var(--color-primary, #2563eb) 50%,
      var(--color-border, #e5e7eb) 50%,
      var(--color-border, #e5e7eb) 100%
    );
    border-radius: 9999px;
  }

  @media (max-width: 640px) {
    .timeline-track {
      left: 1rem;
    }
  }

  .timeline-content {
    padding-left: var(--spacing-12, 3rem);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-12, 3rem);
  }

  @media (max-width: 640px) {
    .timeline-content {
      padding-left: var(--spacing-8, 2rem);
    }
  }

  /* Style direct children (timeline items) */
  .timeline-content :global(> *) {
    position: relative;
  }

  .timeline-content :global(> *)::before {
    content: "";
    position: absolute;
    left: calc(-1 * var(--spacing-12, 3rem) + 1px);
    top: 0.5rem;
    width: 1rem;
    height: 1rem;
    background: var(--color-background, #ffffff);
    border: 3px solid var(--color-primary, #2563eb);
    border-radius: 50%;
    z-index: 1;
  }

  @media (max-width: 640px) {
    .timeline-content :global(> *)::before {
      left: calc(-1 * var(--spacing-8, 2rem) + 1px);
    }
  }

  /* Timeline headings */
  .timeline-content :global(h3) {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text-primary, #111827);
    margin-bottom: var(--spacing-4, 1rem);
  }

  .timeline-content :global(h4) {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-primary, #111827);
    margin-top: var(--spacing-6, 1.5rem);
    margin-bottom: var(--spacing-3, 0.75rem);
  }

  .timeline-content :global(p) {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary, #374151);
    margin-bottom: 0.75rem;
  }

  .timeline-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .timeline-content :global(strong) {
    font-weight: 600;
    color: var(--color-text-primary, #111827);
  }

  @media print {
    .project-timeline {
      padding-left: 0;
    }

    .timeline-track {
      display: none;
    }

    .timeline-content {
      padding-left: 0;
    }

    .timeline-content :global(> *)::before {
      display: none;
    }
  }
</style>
