---
import { Image } from "astro:assets";

interface Props {
  images: string[];
  alt: string;
  autoplay?: boolean;
  interval?: number;
  showControls?: boolean;
  showIndicators?: boolean;
  className?: string;
}

const {
  images,
  alt,
  autoplay = true,
  interval = 5000,
  showControls = true,
  showIndicators = true,
  className = "",
} = Astro.props;

// Generate unique ID for this carousel instance
const carouselId = `carousel-${Math.random().toString(36).substring(2, 9)}`;
---

<div class={`image-carousel ${className}`} data-carousel-id={carouselId}>
  {/* Carousel Container */}
  <div class="carousel-viewport">
    <div class="carousel-track" data-autoplay={autoplay} data-interval={interval}>
      {
        images.map((imageSrc, index) => (
          <div
            class="carousel-slide"
            data-slide-index={index}
            aria-hidden={index !== 0 ? "true" : "false"}
          >
            <Image
              src={imageSrc}
              alt={`${alt} - Image ${index + 1} of ${images.length}`}
              width={800}
              height={600}
              loading={index === 0 ? "eager" : "lazy"}
              class="carousel-image"
            />
          </div>
        ))
      }
    </div>
  </div>

  {/* Navigation Controls */}
  {
    showControls && images.length > 1 && (
      <div class="carousel-controls">
        <button
          class="carousel-button carousel-button-prev"
          aria-label="Previous image"
          data-action="prev"
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="15 18 9 12 15 6" />
          </svg>
        </button>

        <button
          class="carousel-button carousel-button-next"
          aria-label="Next image"
          data-action="next"
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </button>
      </div>
    )
  }

  {/* Indicators */}
  {
    showIndicators && images.length > 1 && (
      <div class="carousel-indicators">
        {images.map((_, index) => (
          <button
            class="carousel-indicator"
            aria-label={`Go to image ${index + 1}`}
            data-slide-to={index}
            aria-current={index === 0 ? "true" : "false"}
          />
        ))}
      </div>
    )
  }
</div>

<style>
  .image-carousel {
    position: relative;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    box-shadow:
      0 4px 6px -1px rgb(0 0 0 / 0.1),
      0 2px 4px -2px rgb(0 0 0 / 0.1);
    background: var(--color-background-subtle);
  }

  /* Viewport */
  .carousel-viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  /* Track */
  .carousel-track {
    display: flex;
    transition: transform 0.5s ease-in-out;
    will-change: transform;
  }

  /* Slides */
  .carousel-slide {
    flex: 0 0 100%;
    width: 100%;
    min-width: 100%;
  }

  .carousel-slide[aria-hidden="true"] {
    visibility: hidden;
  }

  .carousel-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  /* Navigation Controls */
  .carousel-controls {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    display: flex;
    justify-content: space-between;
    padding: 0 1rem;
    pointer-events: none;
  }

  .carousel-button {
    pointer-events: auto;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.9);
    color: var(--color-text-primary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .carousel-button:hover {
    background: rgba(255, 255, 255, 1);
    transform: scale(1.1);
  }

  .carousel-button:active {
    transform: scale(0.95);
  }

  .carousel-button:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Indicators */
  .carousel-indicators {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(8px);
    border-radius: 9999px;
  }

  .carousel-indicator {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
  }

  .carousel-indicator:hover {
    background: rgba(255, 255, 255, 0.75);
    transform: scale(1.2);
  }

  .carousel-indicator[aria-current="true"] {
    background: rgba(255, 255, 255, 1);
    width: 1.5rem;
    border-radius: 9999px;
  }

  .carousel-indicator:focus-visible {
    outline: 2px solid white;
    outline-offset: 2px;
  }

  /* Responsive adjustments */
  @media (max-width: 640px) {
    .carousel-controls {
      padding: 0 0.5rem;
    }

    .carousel-button {
      width: 2rem;
      height: 2rem;
    }

    .carousel-button svg {
      width: 18px;
      height: 18px;
    }
  }
</style>

<script>
  class ImageCarousel {
    private carousel: HTMLElement;
    private track: HTMLElement;
    private slides: NodeListOf<HTMLElement>;
    private indicators: NodeListOf<HTMLButtonElement>;
    private prevButton: HTMLButtonElement | null;
    private nextButton: HTMLButtonElement | null;
    private currentIndex: number = 0;
    private autoplayInterval: number | null = null;
    private isAutoplay: boolean;
    private interval: number;

    constructor(carouselElement: HTMLElement) {
      this.carousel = carouselElement;
      this.track = this.carousel.querySelector(".carousel-track") as HTMLElement;
      this.slides = this.carousel.querySelectorAll(".carousel-slide");
      this.indicators = this.carousel.querySelectorAll(".carousel-indicator");
      this.prevButton = this.carousel.querySelector('[data-action="prev"]');
      this.nextButton = this.carousel.querySelector('[data-action="next"]');

      this.isAutoplay = this.track.dataset.autoplay === "true";
      this.interval = parseInt(this.track.dataset.interval || "5000", 10);

      this.init();
    }

    private init(): void {
      // Add event listeners for controls
      this.prevButton?.addEventListener("click", () => this.prev());
      this.nextButton?.addEventListener("click", () => this.goTo(this.currentIndex + 1));

      // Add event listeners for indicators
      this.indicators.forEach((indicator, index) => {
        indicator.addEventListener("click", () => this.goTo(index));
      });

      // Pause autoplay on hover
      this.carousel.addEventListener("mouseenter", () => this.pauseAutoplay());
      this.carousel.addEventListener("mouseleave", () => this.resumeAutoplay());

      // Keyboard navigation
      this.carousel.addEventListener("keydown", (e) => this.handleKeydown(e));

      // Touch/swipe support
      this.addSwipeSupport();

      // Start autoplay if enabled
      if (this.isAutoplay) {
        this.startAutoplay();
      }
    }

    private goTo(index: number): void {
      // Wrap around
      if (index < 0) {
        index = this.slides.length - 1;
      } else if (index >= this.slides.length) {
        index = 0;
      }

      // Update current index
      this.currentIndex = index;

      // Move track
      const offset = -index * 100;
      this.track.style.transform = `translateX(${offset}%)`;

      // Update slides aria-hidden
      this.slides.forEach((slide, i) => {
        slide.setAttribute("aria-hidden", i !== index ? "true" : "false");
      });

      // Update indicators
      this.indicators.forEach((indicator, i) => {
        indicator.setAttribute("aria-current", i === index ? "true" : "false");
      });

      // Reset autoplay
      if (this.isAutoplay) {
        this.resetAutoplay();
      }
    }

    private prev(): void {
      this.goTo(this.currentIndex - 1);
    }

    private next(): void {
      this.goTo(this.currentIndex + 1);
    }

    private startAutoplay(): void {
      this.autoplayInterval = window.setInterval(() => {
        this.next();
      }, this.interval);
    }

    private pauseAutoplay(): void {
      if (this.autoplayInterval) {
        window.clearInterval(this.autoplayInterval);
        this.autoplayInterval = null;
      }
    }

    private resumeAutoplay(): void {
      if (this.isAutoplay && !this.autoplayInterval) {
        this.startAutoplay();
      }
    }

    private resetAutoplay(): void {
      this.pauseAutoplay();
      this.resumeAutoplay();
    }

    private handleKeydown(e: KeyboardEvent): void {
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        this.prev();
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        this.next();
      }
    }

    private addSwipeSupport(): void {
      let startX = 0;
      let currentX = 0;
      let isDragging = false;

      this.track.addEventListener("touchstart", (e) => {
        startX = e.touches[0].clientX;
        isDragging = true;
      });

      this.track.addEventListener("touchmove", (e) => {
        if (!isDragging) return;
        currentX = e.touches[0].clientX;
      });

      this.track.addEventListener("touchend", () => {
        if (!isDragging) return;
        isDragging = false;

        const diff = startX - currentX;
        const threshold = 50;

        if (Math.abs(diff) > threshold) {
          if (diff > 0) {
            this.next();
          } else {
            this.prev();
          }
        }
      });
    }
  }

  // Initialize all carousels on the page
  document.addEventListener("DOMContentLoaded", () => {
    const carousels = document.querySelectorAll(".image-carousel");
    carousels.forEach((carousel) => {
      new ImageCarousel(carousel as HTMLElement);
    });
  });
</script>
