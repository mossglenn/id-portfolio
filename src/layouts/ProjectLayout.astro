---
import BaseLayout from '@/layouts/BaseLayout.astro';

interface ExternalLink {
  label: string;
  url: string;
  type?: string;
}

interface Frontmatter {
  title: string;
  description: string;
  category?: string;
  tags?: string[];
  heroImage?: string;
  relatedProjects?: string[];
  externalLinks?: ExternalLink[];
  startDate?: string;
  endDate?: string;
  role?: string;
  organization?: string;
}

interface Props {
  frontmatter: Frontmatter;
}

const { frontmatter } = Astro.props;
const {
  title,
  description,
  category,
  tags,
  relatedProjects,
  externalLinks,
  startDate,
  endDate,
} = frontmatter;

// Format dates for display
const formatDate = (dateString?: string) => {
  if (!dateString) return null;
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
};

const formattedStartDate = formatDate(startDate);
const formattedEndDate = endDate ? formatDate(endDate) : 'Present';

// Convert project slugs to readable titles
const formatProjectTitle = (slug: string) => {
  return slug
    .split('-')
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
};

// Determine if sidebar should be shown
const hasSidebarContent = Boolean(
  category ||
  tags?.length ||
  relatedProjects?.length ||
  externalLinks?.length ||
  (startDate || endDate)
);
---

<BaseLayout
  title={title}
  description={description}
  pageType="project"
>
  <article class="project-layout" data-has-sidebar={hasSidebarContent}>
    {/* Main Content */}
    <div class="project-content">
      <slot />
    </div>

    {/* Sidebar */}
    {hasSidebarContent && (
      <aside class="project-sidebar">
        {/* Project Info */}
        {(category || (startDate || endDate)) && (
          <div class="sidebar-section">
            <h3 class="sidebar-heading">Project Info</h3>

            {category && (
              <div class="sidebar-item">
                <span class="sidebar-label">Category</span>
                <span class="sidebar-value">{category}</span>
              </div>
            )}

            {(startDate || endDate) && (
              <div class="sidebar-item">
                <span class="sidebar-label">Timeline</span>
                <span class="sidebar-value">
                  {formattedStartDate && `${formattedStartDate} – `}
                  {formattedEndDate}
                </span>
              </div>
            )}
          </div>
        )}

        {/* Tags */}
        {tags && tags.length > 0 && (
          <div class="sidebar-section">
            <h3 class="sidebar-heading">Tags</h3>
            <div class="tag-list">
              {tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        )}

        {/* Related Projects */}
        {relatedProjects && relatedProjects.length > 0 && (
          <div class="sidebar-section">
            <h3 class="sidebar-heading">Related Projects</h3>
            <ul class="related-list">
              {relatedProjects.map((projectSlug) => (
                <li>
                  <a href={`/projects/${projectSlug}`} class="related-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                    <span>{formatProjectTitle(projectSlug)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* External Links */}
        {externalLinks && externalLinks.length > 0 && (
          <div class="sidebar-section">
            <h3 class="sidebar-heading">Links</h3>
            <ul class="external-list">
              {externalLinks.map((link) => (
                <li>
                  <a
                    href={link.url}
                    class="external-link"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span>{link.label}</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                      <polyline points="15 3 21 3 21 9"></polyline>
                      <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    )}
  </article>

  {/* Back to Projects Navigation */}
  <nav class="project-nav">
    <a href="/projects" class="back-link">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      <span>Back to Projects</span>
    </a>
  </nav>
</BaseLayout>

<style>
  /* Main Layout Grid */
  .project-layout {
    max-width: var(--max-width-wide, 1400px);
    margin: 0 auto;
    padding: var(--spacing-16, 4rem) var(--spacing-page-inline, 1.5rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-12, 3rem);
  }

  /* Two-column layout when sidebar exists */
  @media (min-width: 1024px) {
    .project-layout[data-has-sidebar="true"] {
      grid-template-columns: 1fr 280px;
      gap: var(--spacing-16, 4rem);
    }
  }

  @media (min-width: 1280px) {
    .project-layout[data-has-sidebar="true"] {
      grid-template-columns: 1fr 320px;
    }
  }

  /* Main Content Area */
  .project-content {
    min-width: 0; /* Prevent grid blowout from long words */
  }

  /* ========================================
     SIDEBAR
     ======================================== */

  .project-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8, 2rem);
  }

  /* Show sidebar before content on mobile/tablet */
  @media (max-width: 1023px) {
    .project-sidebar {
      order: -1;
      padding-bottom: var(--spacing-8, 2rem);
      border-bottom: 1px solid var(--color-border, #e5e7eb);
    }
  }

  /* Sticky sidebar on desktop */
  @media (min-width: 1024px) {
    .project-sidebar {
      position: sticky;
      top: calc(var(--header-height, 4rem) + var(--spacing-8, 2rem));
      align-self: start;
      max-height: calc(100vh - var(--header-height, 4rem) - var(--spacing-16, 4rem));
      overflow-y: auto;
      overflow-x: hidden;

      /* Custom scrollbar */
      scrollbar-width: thin;
      scrollbar-color: var(--color-border, #e5e7eb) transparent;
    }

    .project-sidebar::-webkit-scrollbar {
      width: 6px;
    }

    .project-sidebar::-webkit-scrollbar-track {
      background: transparent;
    }

    .project-sidebar::-webkit-scrollbar-thumb {
      background: var(--color-border, #e5e7eb);
      border-radius: 3px;
    }

    .project-sidebar::-webkit-scrollbar-thumb:hover {
      background: var(--color-text-tertiary, #6b7280);
    }
  }

  /* Sidebar Sections */
  .sidebar-section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4, 1rem);
  }

  .sidebar-heading {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-tertiary, #6b7280);
    margin: 0;
  }

  .sidebar-item {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2, 0.5rem);
  }

  .sidebar-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-tertiary, #6b7280);
  }

  .sidebar-value {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-primary, #111827);
    line-height: 1.5;
  }

  /* Tags */
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2, 0.5rem);
  }

  .tag {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.375rem 0.75rem;
    background: var(--color-background-subtle, #f9fafb);
    color: var(--color-text-secondary, #374151);
    border-radius: var(--radius-full, 9999px);
    border: 1px solid var(--color-border, #e5e7eb);
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .tag:hover {
    background: var(--color-background-elevated, #f1f5f9);
    border-color: var(--color-text-tertiary, #6b7280);
  }

  /* Lists */
  .related-list,
  .external-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3, 0.75rem);
  }

  /* Related Projects Links */
  .related-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary, #374151);
    text-decoration: none;
    transition: color 0.2s ease;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: var(--spacing-2, 0.5rem);
    margin: calc(-1 * var(--spacing-2, 0.5rem));
    border-radius: var(--radius-md, 6px);
  }

  .related-link svg {
    flex-shrink: 0;
    color: var(--color-text-tertiary, #6b7280);
    transition: transform 0.2s ease;
  }

